# ============================================================
# ElectricTools .gitignore
# ============================================================

# --- 内嵌运行时（体积大，约定本地提供，不入库）---
/env/

# --- 密钥与本地配置（含敏感信息，禁止入库）---
.env
config.yaml
*.local.yaml

# --- Node / 前端构建 ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# --- 用户数据与导出（保留目录占位）---
storage/circuits/*
storage/records/*
storage/exports/*
!storage/circuits/.gitkeep
!storage/records/.gitkeep
!storage/exports/.gitkeep
storage/*.db

# --- 运行日志 ---
.server.log

# --- 编辑器 / 系统 ---
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
*.swp
