# ============================================================
# ElectricTools 环境变量模板（Q8）
# ------------------------------------------------------------
# 用法：把本文件内容复制到项目根目录的 .env 文件，填入真实值。
# 说明：真实 .env 已被 .gitignore 忽略，切勿提交真实密钥。
#       （本模板用 env.example 命名，避免与受保护的 .env 同名。）
# ============================================================

# DeepSeek API Key（必填；仅本地 .env / 系统环境变量，绝不写入存档或仓库）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认 API 基址
# DEEPSEEK_BASE_URL=https://api.deepseek.com
